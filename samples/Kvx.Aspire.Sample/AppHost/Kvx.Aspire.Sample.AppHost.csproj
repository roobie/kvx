<Project Sdk="Aspire.AppHost.Sdk/13.6.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Runs with DCP and the dashboard from NuGet; the Aspire CLI is not required. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Worker\Kvx.Aspire.Sample.Worker.csproj" />
    <ProjectReference Include="..\..\..\src\Kvx.Aspire.Hosting\Kvx.Aspire.Hosting.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
